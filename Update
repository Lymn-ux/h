-- Animasi Putar Gear Halus
local rotationConn
rotationConn = RunService.RenderStepped:Connect(function(dt)
    if GearLogo and GearLogo.Parent then
        GearLogo.Rotation = GearLogo.Rotation + (60 * dt)
    else
        rotationConn:Disconnect()
    end
end)

