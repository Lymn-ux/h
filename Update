local CoreGui = game:GetService("CoreGui")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local setclipboard = setclipboard or toclipboard or function(text) print("Clipboard:", text) end

-- 1. Automatic Copy to Clipboard
setclipboard("https://discord.gg/s2rnnmWa38")

-- 2. GUI Setup (Full Layar & Ignore Notch/Inset Roblox)
