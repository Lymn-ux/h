-- 3. Countdown & Fade Out Animation
task.spawn(function()
    for i = 3, 1, -1 do
        CountdownLabel.Text = tostring(i)
        task.wait(1)
    end
    
    -- Smooth Fade Out Full Screen
    local fadeInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    
    local bgTween = TweenService:Create(BlackBackground, fadeInfo, {BackgroundTransparency = 1})
    local titleTween = TweenService:Create(TitleLabel, fadeInfo, {TextTransparency = 1})
    local maintTween = TweenService:Create(MaintenanceLabel, fadeInfo, {TextTransparency = 1})
    local countdownTween = TweenService:Create(CountdownLabel, fadeInfo, {TextTransparency = 1})
    local copyTween = TweenService:Create(CopyNotice, fadeInfo, {TextTransparency = 1})

    bgTween:Play()
    titleTween:Play()
    maintTween:Play()
    countdownTween:Play()
    copyTween:Play()

    bgTween.Completed:Connect(function()
        if rotationConn then
            rotationConn:Disconnect()
        end
        ScreenGui:Destroy()
    end)
end)
